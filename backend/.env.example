# --- Fast API ---
DEBUG=True

# --- Security ---
# Generate a secure 32-byte secret key (e.g., using: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# --- Database (Supabase PostgreSQL - Connection Pooler) ---
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
# Note: For the connection pooler, the user must include the project reference ID (e.g., postgres.xxxx)
DB_USER=postgres.your_supabase_project_ref_here
DB_PASSWORD=your_database_password_here

# --- JWT Authentication ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# --- Supabase Storage & Services ---
SUPABASE_URL=https://your_supabase_project_ref_here.supabase.co
# Service Role Key for backend operations
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=invoices

# --- CORS Origins ---
# Comma-separated origins for local development and Production Admin Web
CORS_ORIGINS=http://localhost:3000,https://admin.shcc.co.in
